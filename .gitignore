licenses/

# CI test reports, coverage, Playwright E2E, and API acceptance output
.reports/

# Vitest coverage output (per-project; canonical copy under .reports/node/<name>/coverage)
coverage/

# DeepEval local test-run cache (make eval-live)
.deepeval/
.deepeval-cache.json

# DeepEval timestamped copies (stable reports/eval/generation.md is committed)
reports/eval/generation_*.md

# Generated OpenAPI YAML (committed — regenerate with `make generate-openapi`)
# openapi/*.yaml is tracked; JSON twins are not used
openapi/*.json

# OpenAPI-generated Python clients (run `make generate-keycloak-client`)
packages/generated/

# IDE / editor (keep project rules in git)
.cursor/*
