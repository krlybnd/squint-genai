      ]
    },
    {
      "username": "bob@tenant-b.local",
      "enabled": true,
      "email": "bob@tenant-b.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "TenantB",
      "attributes": {
        "tenant_id": [
          "tenant-b"
        ],
        "tenant_roles": [
          "{\"tenant-b\":[\"read\"]}"
        ]
      },
      "realmRoles": [
        "read"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-agentic-rag-eval-api",
      "enabled": true,
      "serviceAccountClientId": "agentic-rag-eval-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "service-account-agentic-rag-eval-admin",
      "enabled": true,
      "serviceAccountClientId": "agentic-rag-eval-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "manage-realm",
          "view-realm"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Active tenant\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"tenant_roles\",\"displayName\":\"Tenant roles (JSON map)\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"},{\"name\":\"multitenancy\",\"displayHeader\":\"Multitenancy\",\"displayDescription\":\"Active tenant and per-tenant role assignments\"}]}"
          ]
        }
      }
    ]
  }
}
