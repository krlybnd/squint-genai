        {
          "type": "password",
          "value": "reader",
          "temporary": false
        }
      ]
    },
    {
      "username": "writer@tenant-a.local",
      "enabled": true,
      "email": "writer@tenant-a.local",
      "emailVerified": true,
      "firstName": "Writer",
      "lastName": "TenantA",
      "attributes": {
        "tenant_id": [
          "tenant-a"
        ]
      },
      "realmRoles": [
        "read",
        "write"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "writer",
          "temporary": false
        }
      ]
    },
    {
      "username": "alice@tenant-a.local",
      "enabled": true,
      "email": "alice@tenant-a.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "TenantA",
      "attributes": {
        "tenant_id": [
          "tenant-a"
