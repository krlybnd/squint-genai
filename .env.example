# LLM — LiteLLM role aliases (operations/litellm/litellm.config.yaml)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MODEL=generate
LITELLM_ROUTER_MODEL=router
LITELLM_JUDGE_MODEL=judge
# Provider key for LiteLLM -> OpenAI (only the litellm service needs this)
OPENAI_API_KEY=sk-change-me
# Bearer token for apps -> LiteLLM proxy (must match litellm master_key)
LITELLM_MASTER_KEY=sk-change-me

# Optional: local classifiers (make up-guardrails) — chat/api Guard / analyzer / anonymizer clients
# Uncomment when running the guardrails profile (docker DNS from api/chat containers):
ANALYZER_API_BASE=http://presidio-analyzer:3000
ANONYMIZER_API_BASE=http://presidio-anonymizer:3000
GUARD_API_BASE=http://llm-guard:8000
GUARD_AUTH_TOKEN=poc-local-classifier
# Optional: LiteLLM built-in Presidio guardrail experiments
PRESIDIO_ANALYZER_API_BASE=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_API_BASE=http://presidio-anonymizer:3000
# LLM_GUARD_HF_CACHE=../../pocs/local_classifier/run/hf-cache

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic_rag_eval
DATABASE_URL=postgresql+asyncpg://agentic:agentic@postgres:5432/agentic_rag_eval
# Optional: explicit sync/checkpoint URLs (otherwise derived from DATABASE_URL)
# DATABASE_URL_PSYCOPG2=postgresql+psycopg2://agentic:agentic@postgres:5432/agentic_rag_eval
# CHECKPOINT_DATABASE_URL=postgresql://agentic:agentic@postgres:5432/agentic_rag_eval

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_SECONDS=3600

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=agentic_rag_eval_hybrid
CANDIDATE_TOP_K=30

# FastAPI — CORS / docs / security headers (identity: FrameworkDefaults.from_distribution
# → PackageInfo from each service pyproject; not APP_TITLE env vars)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost
# CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOW_METHODS=*
# CORS_ALLOW_HEADERS=*
# DOCS_URL=/docs
# REDOC_URL=/redoc
# OPENAPI_URL=/openapi.json
# SECURITY_HEADERS_ENABLED=true
# SECURITY_HEADERS_X_FRAME_OPTIONS=DENY
# SECURITY_HEADERS_CONTENT_SECURITY_POLICY=default-src 'self'

# Services
LOG_LEVEL=INFO
API_KEY=dev-admin-key-change-me
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
AUTH_MODE=jwt
ROLES={"admin":"admin","read":"read","write":"write"}
# Index
EMBEDDING_MODEL=embed
TOP_K=5

# Eval harness lives in tests/eval/.env.example (copy to tests/eval/.env)

# LangSmith prod tracing (chat LangGraph workflow)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-eval
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Compliance (GDPR / NIS2 / EU AI Act hooks — see docs/compliance.md)
COMPLIANCE_ENABLED=false
AUDIT_LOG_ENABLED=true
AI_TRANSPARENCY_ENABLED=true
AI_SYSTEM_NAME=agentic-rag-eval
AI_RISK_TIER=limited
AI_HUMAN_OVERSIGHT=true
DOCUMENT_RETENTION_DAYS=365
CHAT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730

# Keycloak + Traefik (optional — docker compose --profile auth)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=agentic-rag-eval
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_ID=agentic-rag-eval-api
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-api-client-secret
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8088

# Frontend (Vite build-time; set AUTH_MODE=jwt + profile auth for OIDC)
VITE_AUTH_ENABLED=true
VITE_KEYCLOAK_URL=http://localhost
VITE_KEYCLOAK_REALM=agentic-rag-eval
VITE_KEYCLOAK_CLIENT_ID=agentic-rag-eval-ui
# Optional build-time API overrides (defaults come from each app's app.config.ts + public/config.json)
# VITE_API_URL=/api
# VITE_CHAT_URL=/chat
# VITE_ADMIN_URL=/admin-api
# VITE_API_KEY=dev-admin-key-change-me
