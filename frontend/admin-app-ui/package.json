{
  "name": "@are/admin-app-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:api && vite",
    "build": "APP_NAME=admin npm run generate:api && tsc -b && vite build",
    "preview": "vite preview",
    "generate:api": "APP_NAME=admin node ../../packages/ui-core/scripts/generate-api.mjs",
    "postinstall": "APP_NAME=admin npm run generate:api",
    "lint": "eslint src && stylelint \"src/**/*.css\" && APP_NAME=admin npm run generate:api && tsc -b --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@are/ui-core": "*",
    "i18next": "^26.3.4",
    "keycloak-js": "^26.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.1",
    "stylelint": "^16.18.0",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
