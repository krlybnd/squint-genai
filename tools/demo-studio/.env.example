# Copy to .env. Stack: make up-auth (Traefik http://localhost).
DEMO_BASE_URL=http://localhost
DEMO_HEADED=0

DEMO_AUTH=1
DEMO_USER=admin
DEMO_PASSWORD=admin
DEMO_ALICE_USER=alice@tenant-a.local
DEMO_ALICE_PASSWORD=alice

# LLM-as-judge (guardrail / answer checks). Host LiteLLM — not compose LITELLM_BASE_URL.
DEMO_JUDGE_BASE_URL=http://127.0.0.1:4000
DEMO_JUDGE_MODEL=judge
