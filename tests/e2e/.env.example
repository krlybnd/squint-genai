# Copy to .env and adjust for your stack (Traefik or Vite dev server).
E2E_BASE_URL=http://localhost
E2E_HEADED=0

# Fast defaults — npm test uses direct clicks, no artificial delays.
# For slow demo videos: npm run test:demo

# Keycloak UI login (make up-auth). Skip when frontend runs with VITE_AUTH_ENABLED=false.
E2E_AUTH=1
E2E_USER=admin
E2E_PASSWORD=admin

# Optional dedicated users (realm import); defaults match operations/keycloak/realm/agentic-rag-eval-realm.json
# E2E_WRITE_USER=
# E2E_WRITE_PASSWORD=
# E2E_READONLY_USER=bob@tenant-b.local
# E2E_READONLY_PASSWORD=bob
# E2E_NON_ADMIN_USER=writer@tenant-a.local
# E2E_NON_ADMIN_PASSWORD=writer
