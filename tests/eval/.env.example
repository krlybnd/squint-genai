# Copy to .env (gitignored). Pydantic-settings loads this file — do not `source` it
# (bash mangles JSON). Host process → published compose ports, not docker DNS.

EVAL_TENANT_ID=tenant-a
EVAL_JUDGE_MODEL=judge
EVAL_MAX_CONCURRENCY=20
# DeepEval judge (gpt-4o, LiteLLM rpm: 30). One metric at a time + 2s throttle.
# Faithfulness/Relevancy must use async_mode=False (set in the runner).
EVAL_JUDGE_MAX_CONCURRENCY=1
EVAL_JUDGE_THROTTLE_SECONDS=2
# Applied onto DeepEval's Settings singleton (not process env).
# EVAL_JUDGE_RETRY_MAX_ATTEMPTS=10
# EVAL_JUDGE_RETRY_INITIAL_SECONDS=2
# EVAL_JUDGE_RETRY_CAP_SECONDS=60

# Bearer for LiteLLM — same value as repo-root LITELLM_MASTER_KEY.
# Empty values are ignored.
LITELLM_MASTER_KEY=sk-change-me
# EVAL_SUT_LITELLM_API_KEY=
EVAL_SUT_LITELLM_BASE_URL=http://localhost:4000
# Optional gate overrides (defaults are the investigation corpus)
# EVAL_RETRIEVAL_K=5
# EVAL_RETRIEVAL_MINIMUMS_DOCUMENT_RECALL_AT_K=0.90
# EVAL_RETRIEVAL_MINIMUMS_CHUNK_PRECISION_AT_K=0.85
# EVAL_RETRIEVAL_MINIMUMS_HIT_RATE_AT_K=0.90
# EVAL_RETRIEVAL_MINIMUMS_MRR=0.80
# EVAL_RETRIEVAL_MINIMUMS_NDCG_AT_K=0.80
# EVAL_GENERATION_CORRECTNESS_THRESHOLD=0.80
# EVAL_GENERATION_FAITHFULNESS_THRESHOLD=0.85
# EVAL_GENERATION_ANSWER_RELEVANCY_THRESHOLD=0.70
# EVAL_GOLDEN_KNOWN_SOURCE_FILES=["custom.pdf"]

# Generation talks to chat/api via generated OpenAPI clients (make generate-openapi-clients).
EVAL_SUT_CHAT_URL=http://localhost:8002
EVAL_SUT_API_URL=http://localhost:8000
# Same values as repo-root .env when AUTH_MODE=jwt (default compose).
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
# API_KEY=dev-admin-key-change-me

# llm-guard + Presidio (host-side live eval / tests — published compose ports)
# GUARD_API_BASE=http://localhost:8010
# GUARD_AUTH_TOKEN=poc-local-classifier
# ANALYZER_API_BASE=http://localhost:5002
# ANONYMIZER_API_BASE=http://localhost:5001

DEEPEVAL_TELEMETRY_OPT_OUT=YES
