# Copy to .env (gitignored). Pydantic-settings loads this file — do not `source` it
# (bash mangles JSON). Host process → published compose ports, not docker DNS.

EVAL_MODE=live
EVAL_TENANT_ID=tenant-a
EVAL_JUDGE_MODEL=judge
EVAL_MAX_CONCURRENCY=20
# DeepEval judge (gpt-4o, LiteLLM rpm: 30). One metric at a time + 2s throttle.
# Faithfulness/Relevancy must use async_mode=False (set in the runner).
EVAL_JUDGE_MAX_CONCURRENCY=1
EVAL_JUDGE_THROTTLE_SECONDS=2

# Bearer for LiteLLM — same value as repo-root OPENAI_API_KEY
# (or LITELLM_MASTER_KEY if you set one there). Empty values are ignored.
OPENAI_API_KEY=sk-change-me
# EVAL_SUT_LITELLM_API_KEY=
EVAL_SUT_LITELLM_BASE_URL=http://localhost:4000
EVAL_SUT_QDRANT_URL=http://localhost:6333
# Must match the running stack's QDRANT_COLLECTION (repo-root .env).
EVAL_SUT_QDRANT_COLLECTION=agentic_rag_eval_hybrid
EVAL_SUT_EMBEDDING_MODEL=embed
EVAL_SUT_RERANK_MODEL=rerank
EVAL_SUT_RERANK_ENABLED=false

# Optional gate overrides (defaults match calibrated thresholds)
# EVAL_RETRIEVAL_K=5
# EVAL_RETRIEVAL_MINIMUMS_RECALL_AT_K=0.75
# EVAL_RETRIEVAL_MINIMUMS_PRECISION_AT_K=0.45
# EVAL_RETRIEVAL_MINIMUMS_HIT_RATE_AT_K=0.75
# EVAL_RETRIEVAL_MINIMUMS_MRR=0.65
# EVAL_RETRIEVAL_MINIMUMS_NDCG_AT_K=0.65
# EVAL_GENERATION_FAITHFULNESS_THRESHOLD=0.70
# EVAL_GENERATION_ANSWER_RELEVANCY_THRESHOLD=0.55
# EVAL_GOLDEN_KNOWN_SOURCE_FILES=["custom.pdf"]

DEEPEVAL_TELEMETRY_OPT_OUT=YES
