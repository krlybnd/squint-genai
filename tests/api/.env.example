# Live service origins (docker compose `make up`).
API_BASE_URL=http://localhost:8000
CHAT_BASE_URL=http://localhost:8002
ADMIN_BASE_URL=http://localhost:8003

# Sent as X-API-Key when AUTH_MODE=api_key. Harmless when AUTH_MODE=none.
API_KEY=dev-admin-key-change-me
API_TENANT_ID=default

# Guardrails acceptance (features/05_guardrails.feature) — host ports from compose.
# Requires: make up && make up-guardrails, and chat/api .env GUARD_* pointing at llm-guard.
GUARD_API_BASE=http://localhost:8010
GUARD_AUTH_TOKEN=poc-local-classifier
# Optional: skip indexed-documents lookup for comment scenarios
# API_TEST_CHUNK_ID=

# PII vault acceptance (features/06_pii_vault.feature)
# Requires indexing worker INDEXING_PDF_PII_TOKENIZATION_ENABLED=true and migration 003.
ANALYZER_API_BASE=http://localhost:5002
# PII_VAULT_ENABLED=true
# PII_VAULT_TESTS_ENABLED=true
